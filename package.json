{
  "name": "@cairncommons/mcp",
  "version": "1.1.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Cairn participation tools: local MCP, agent skills and A2A schemas. Bring your own agent and compute.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cairncommons/cairn-commons.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test scripts/mcp-card.test.ts scripts/mcp-store.test.ts",
    "sync:documents": "node scripts/sync-documents.mjs",
    "check:documents": "node scripts/sync-documents.mjs --check",
    "build:bundle": "node scripts/build-bundle.mjs",
    "start": "tsx scripts/cairn-mcp.ts"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "esbuild": "0.28.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
