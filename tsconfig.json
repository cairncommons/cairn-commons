{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true
  },
  "include": ["lib/**/*.ts", "scripts/**/*.ts"],
  // The hook is plain JavaScript (no declarations); its test file imports it untyped and is run, not type-checked.
  "exclude": ["scripts/cairn-lookup.test.ts"]
}
